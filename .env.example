# Copy this file to .env and fill in the values. The .env file is NOT committed.

# Environment: Development (migrations are applied automatically) or Production
ASPNETCORE_ENVIRONMENT=Development

# Database connection string (PostgreSQL)
ConnectionStrings__Default=Host=<host>;Database=aidesigner_dev;Username=<user>;Password=<password>;SSL Mode=Require

# Base URL of the app's own HTTP API (used by clients in Clients/)
ApiBaseUrl=https://localhost:7003/

# Gallery settings
Gallery__MaxItems=100
Gallery__MaxImageBytes=5242880
Gallery__SavesPerMinute=5

# AI (not used yet, planned for S2)
# Ai__Cloud__Provider=Gemini
# Ai__Cloud__ApiKey=
# Ai__Local__OllamaUrl=http://localhost:11434
# Ai__Local__Model=