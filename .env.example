# Copy this file to .env and fill in the values. The .env file is NOT committed.

# Environment: Development (migrations are applied automatically) or Production
ASPNETCORE_ENVIRONMENT=Development

# Database connection string (PostgreSQL)
ConnectionStrings__Default=Host=<host>;Database=aidesigner_dev;Username=<user>;Password=<password>;SSL Mode=Require

# Base URL of the app's own HTTP API (used by clients in Clients/)
# HTTP for now: it must match the "http" launch profile (dotnet run -> http://localhost:5245).
ApiBaseUrl=http://localhost:5245/

# Gallery settings
Gallery__MaxItems=100
Gallery__MaxImageBytes=5242880
Gallery__SavesPerMinute=5

# Cloud AI (Google Gemini). Empty key -> "Cloud AI" mode is disabled. Key from Google AI Studio, server only.
Ai__Gemini__ApiKey=
Ai__Gemini__Model=gemini-2.5-flash

# Local AI (Ollama). Not running -> "Local AI" mode is disabled.
# Model is optional: empty -> the first installed model that supports images.
Ai__Ollama__BaseUrl=http://localhost:11434/
Ai__Ollama__Model=