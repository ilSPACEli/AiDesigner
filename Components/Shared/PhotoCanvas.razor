@implements IAsyncDisposable
@inject IJSRuntime JS

@* Blazor не рендерить вміст цього div: canvas усередині створює JavaScript. *@
<div class="canvas-host" @ref="_host"></div>

@code {
    // Найбільший PNG, який приймаємо з браузера.
    private const long MaxPngSize = 100 * 1024 * 1024;

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _canvas;

    private IJSObjectReference Canvas =>
        _canvas ?? throw new InvalidOperationException("Полотно ще не готове.");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/photoCanvas.js");
        _canvas = await _module.InvokeAsync<IJSObjectReference>("create", _host);
    }

    /// <summary>Показати фото. Байти передаються потоком, а не одним великим повідомленням.</summary>
    public async Task SetPhotoAsync(byte[] content)
    {
        using var stream = new MemoryStream(content);
        using var streamRef = new DotNetStreamReference(stream);
        await Canvas.InvokeVoidAsync("setPhoto", streamRef);
    }

    /// <summary>Показати предмет (шлях до PNG відносно wwwroot).</summary>
    public async Task SetItemAsync(string imageUrl) =>
        await Canvas.InvokeVoidAsync("setItem", imageUrl);

    /// <summary>Отримати PNG «фото + предмет» у роздільності оригіналу.</summary>
    public async Task<byte[]> ExportPngAsync()
    {
        await using var jsStream = await Canvas.InvokeAsync<IJSStreamReference>("exportPng");
        await using var stream = await jsStream.OpenReadStreamAsync(MaxPngSize);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_canvas is not null)
            {
                await _canvas.InvokeVoidAsync("dispose");
                await _canvas.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Користувач закрив вкладку — браузера вже немає, прибирати нічого.
        }
    }
}
