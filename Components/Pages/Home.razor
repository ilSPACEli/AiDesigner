@page "/"
@using AiDesigner.Models
@using AiDesigner.Services
@using AiDesigner.Clients.Design
@inject DesignService Design
@inject IJSRuntime JS

<PageTitle>ШІ-дизайнер інтер'єру</PageTitle>

<main class="page">
    <header>
        <h1>ШІ-дизайнер інтер'єру</h1>
        <p class="state">Стан сесії: <code>@Session.State</code></p>
    </header>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="message @(_isError ? "error" : "info")">@_message</div>
    }

    <div class="layout">
        @* 1. Фото й полотно (UC-01, UC-04) *@
        <section class="step canvas-panel">
            <h2>1. Фото приміщення</h2>
            <InputFile OnChange="OnPhotoSelectedAsync" accept="image/jpeg,image/png"
                       aria-label="Оберіть фото приміщення"
                       disabled="@(!CanPickPhoto)" />

            @* Зйомка камерою (FR-01) — лише на телефоні/планшеті; на ПК блок прихований стилями. *@
            <div class="camera-only">
                <label class="btn camera-btn">
                    Зробити фото камерою
                    <InputFile OnChange="OnPhotoSelectedAsync" accept="image/jpeg,image/png"
                               capture="environment"
                               aria-label="Зробити фото камерою"
                               disabled="@(!CanPickPhoto)" />
                </label>
                @* UC-01 A3: якщо камера недоступна, браузер відкриє вибір файла. *@
                <p class="hint">Якщо камера недоступна, оберіть фото з галереї кнопкою вище.</p>
            </div>

            <PhotoCanvas @ref="_canvas" OnPlacementChanged="OnPlacementChanged" />
            @if (Session.Photo is null)
            {
                <p class="hint">Оберіть фото у форматі JPEG або PNG.</p>
            }
            else if (Session.State == SessionState.SAVED)
            {
                <p class="hint">Результат збережено. Щоб продовжити редагування, оберіть інший предмет.</p>
            }
            else if (Session.Placement is not null)
            {
                <p class="hint">Перетягуйте предмет і змінюйте його розмір за кутові маркери.</p>
            }
        </section>

        <div class="steps">
            @* 2. Аналіз (UC-02) *@
            <section class="step">
                <h2>2. Аналіз</h2>

                @* Режим аналізу (FR-18): недоступний вимкнено з причиною від сервісу. *@
                <fieldset class="modes" disabled="@(!CanChangeMode)">
                    <legend>Режим аналізу</legend>
                    @foreach (var option in _modeOptions)
                    {
                        <label class="mode @(option.IsEnabled ? null : "unavailable")">
                            <input type="radio" name="analysis-mode" value="@option.Mode"
                                   checked="@(_mode == option.Mode)" disabled="@(!option.IsEnabled)"
                                   @onchange="() => SelectMode(option.Mode)" />
                            <span>@option.Label</span>
                            @if (option.Reason is not null)
                            {
                                <small class="reason">@option.Reason</small>
                            }
                        </label>
                    }
                    <button type="button" class="btn btn-secondary btn-small" @onclick="RefreshModesAsync"
                            disabled="@_checkingModes">
                        @(_checkingModes ? "Перевірка…" : "Перевірити ще раз")
                    </button>
                </fieldset>
                @if (AnalysisModePicker.Warning(_mode) is { } warning)
                {
                    <p class="hint mode-warning">@warning</p>
                }

                @* Згода перед першим аналізом у «Хмарний ШІ» (NFR-04, AC-31). *@
                @if (_askingConsent)
                {
                    <div class="consent" role="dialog" aria-labelledby="consent-title">
                        <strong id="consent-title">@AnalysisModePicker.CloudConsentTitle</strong>
                        <p>@AnalysisModePicker.CloudConsentText</p>
                        <div class="consent-actions">
                            <button class="btn" @onclick="AcceptConsentAsync">@AnalysisModePicker.ConsentAcceptLabel</button>
                            <button class="btn btn-secondary" @onclick="DeclineConsent">@AnalysisModePicker.ConsentCancelLabel</button>
                        </div>
                    </div>
                }

                <button class="btn" @onclick="AnalyzeAsync" disabled="@(!CanAnalyze)">
                    @(Session.IsAnalyzing ? "Аналіз…" : "Аналіз")
                </button>

                @if (Session.Analysis is { } analysis)
                {
                    var view = AnalysisResultView.From(analysis, _analysisNotice);
                    <div class="palette">
                        @foreach (var color in analysis.Colors)
                        {
                            <div class="swatch">
                                <span class="chip" style="background:@color.Hex"></span>
                                <span>@color.Hex</span>
                                <span class="share">@color.Share.ToString("0.#") %</span>
                            </div>
                        }
                    </div>
                    <p>Освітленість: <strong>@view.LightingText</strong></p>
                    @if (view.Style is { } style)
                    {
                        <p class="style @(style.IsDetermined ? null : "undetermined")">@style.Text</p>
                    }
                    <p class="mode-used">@view.ModeText</p>
                    @if (view.Notice is not null)
                    {
                        <p class="notice" role="status">@view.Notice</p>
                    }
                }
            </section>

            @* 3. Пропозиції (UC-03) *@
            <section class="step">
                <h2>3. Пропозиції</h2>
                <button class="btn" @onclick="SuggestAsync" disabled="@(Session.State != SessionState.ANALYZED)">
                    Підібрати предмети
                </button>

                <ul class="suggestions">
                    @foreach (var suggestion in Session.Suggestions)
                    {
                        var item = suggestion.Item;
                        <li class="@(Session.Placement?.Item.Id == item.Id ? "selected" : null)">
                            <img src="@item.ImageFile" alt="@item.Name" />
                            <div class="info">
                                <strong>@item.Name</strong>
                                <span>@suggestion.Reason</span>
                            </div>
                            <button class="btn" @onclick="() => ChooseAsync(item)" disabled="@_busy">Обрати</button>
                        </li>
                    }
                </ul>
            </section>

            @* 4. Збереження (UC-04) *@
            <section class="step">
                <h2>4. Збереження</h2>
                <div class="save-actions">
                    <button class="btn" @onclick="SaveAsync"
                            disabled="@(Session.State != SessionState.ITEM_PLACED || _busy)">
                        @(_saving ? "Збереження…" : "Зберегти в галерею")
                    </button>
                    <button class="btn btn-secondary" @onclick="DownloadAsync"
                            disabled="@(Session.State is not (SessionState.ITEM_PLACED or SessionState.SAVED) || _busy)">
                        Завантажити
                    </button>
                </div>
                @if (Session.SavedResults.Count > 0)
                {
                    <ul class="saved">
                        @foreach (var saved in Session.SavedResults)
                        {
                            <li>@saved.FileName</li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
</main>

@code {
    private PhotoCanvas _canvas = default!;
    private string? _message;
    private bool _isError;
    private bool _busy;
    private bool _saving;   // лише для напису на кнопці «Зберегти»
    private bool _loadingPhoto;

    // Режим аналізу (S2): що показати — вирішує AnalysisModePicker, сторінка лише зберігає вибір.
    private AnalysisMode _mode = AnalysisModePicker.DefaultMode;
    private IReadOnlyList<ModeOption> _modeOptions = AnalysisModePicker.Options(null);
    private bool _checkingModes;
    private bool _askingConsent;
    private string? _analysisNotice;   // AC-30: режим ШІ не відповів

    private DesignSession Session => Design.Session;

    private bool CanAnalyze =>
        Session.State == SessionState.PHOTO_LOADED && !Session.IsAnalyzing && !_loadingPhoto && !Design.IsLoadingPhoto
        && !_askingConsent;

    private bool CanChangeMode => !Session.IsAnalyzing && !_askingConsent;

    // Доступність режимів перевіряємо після першого показу, коли вже є інтерактивне з'єднання
    // (як у «Галереї»): перевірка Ollama й Gemini може тривати кілька секунд.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshModesAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshModesAsync()
    {
        if (_checkingModes)
            return;

        _checkingModes = true;
        try
        {
            var modes = await Design.GetModesAsync();
            _modeOptions = AnalysisModePicker.Options(modes);
        }
        catch (Exception)
        {
            // Перевірка не вдалася — режими ШІ вимкнені, «Аналіз без ШІ» лишається (FR-18).
            _modeOptions = AnalysisModePicker.OptionsAfterCheckFailed();
        }
        finally
        {
            _mode = AnalysisModePicker.KeepSelectable(_mode, _modeOptions);
            _checkingModes = false;
        }
    }

    private void SelectMode(AnalysisMode mode) =>
        _mode = AnalysisModePicker.KeepSelectable(mode, _modeOptions);

    // Поки фото читається або показується, обидва поля вибору й «Аналіз» вимкнені (UC-01).
    private bool CanPickPhoto => !Session.IsAnalyzing && !_busy && !_loadingPhoto && !Design.IsLoadingPhoto;

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        if (!CanPickPhoto)
            return;

        _loadingPhoto = true;
        try
        {
            var file = e.File;

            // Завеликий файл відхиляємо ще до читання (NFR-06, UC-01 A2).
            var sizeCheck = Design.CheckFileSize(file.Size);
            if (!sizeCheck.IsSuccess)
            {
                ShowError(sizeCheck.Message);
                return;
            }

            // Фото тримаємо тільки в пам'яті, на диск не пишемо (NFR-04).
            await using var stream = file.OpenReadStream(Photo.MaxSizeBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var content = buffer.ToArray();

            // Порядок «перевірка → полотно → сесія» гарантує сервіс.
            var result = await Design.LoadPhotoAsync(file.Name, content, _canvas.SetPhotoAsync);
            if (result.IsSuccess)
                ShowInfo("Фото завантажено. Натисніть «Аналіз».");
            else
                ShowError(result.Message);
        }
        catch (Exception)
        {
            // Будь-яка непередбачена помилка — повідомлення, а не падіння сторінки.
            ShowError("Не вдалося завантажити фото. Спробуйте ще раз або оберіть інший файл.");
        }
        finally
        {
            _loadingPhoto = false;
        }
    }

    private async Task AnalyzeAsync()
    {
        _message = null;
        _mode = AnalysisModePicker.KeepSelectable(_mode, _modeOptions);

        // «Хмарний ШІ» без згоди: фото не надсилаємо, спершу питаємо (AC-31).
        if (AnalysisModePicker.NextStep(_mode, Design.HasCloudConsent) == AnalyzeStep.AskCloudConsent)
        {
            _askingConsent = true;
            return;
        }

        await RunAnalysisAsync();
    }

    private async Task AcceptConsentAsync()
    {
        _askingConsent = false;
        Design.GiveCloudConsent();   // діє до кінця сесії

        // Поки питали згоду, фото могли замінити або аналіз уже не можна запустити — лише запам'ятовуємо згоду.
        if (CanAnalyze)
            await RunAnalysisAsync();
    }

    private void DeclineConsent()
    {
        _askingConsent = false;
        ShowInfo(AnalysisModePicker.ConsentDeclinedMessage);
    }

    private async Task RunAnalysisAsync()
    {
        _analysisNotice = null;
        var outcome = await Design.AnalyzeAsync(_mode);

        if (outcome.Status == AnalysisStatus.Success)
        {
            _analysisNotice = outcome.Notice;
            ShowInfo(AnalysisResultView.Completed(outcome.Notice));
        }
        else
            ShowError(outcome.Message);
    }

    private async Task SuggestAsync()
    {
        var result = await Design.SuggestAsync();
        if (result.IsSuccess)
            ShowInfo("Оберіть предмет зі списку.");
        else
            ShowError(result.Message);
    }

    private async Task ChooseAsync(CatalogItem item)
    {
        // Один вибір за раз: інакше два швидкі кліки покажуть на полотні один предмет, а в сесію запишуть інший.
        // Поки _busy, кнопки «Обрати», «Зберегти» й вибір нового фото вимкнені.
        if (_busy)
            return;

        _busy = true;
        try
        {
            // Предмет спершу прихований: показати його треба вже на місці, а місце рахує сервіс (AC-08).
            var size = await _canvas.SetItemAsync(item.ImageFile, hidden: true);
            if (size is null)
            {
                // Браузер виконує застарілу копію photoCanvas.js: розмірів предмета немає.
                ShowError("Не вдалося показати предмет на фото. Оновіть сторінку (Ctrl+F5) і спробуйте ще раз.");
                return;
            }

            var start = Design.PlaceItemAtCenter(item, size.Width, size.Height);
            await _canvas.ApplyPlacementAsync(start);
            ShowInfo($"Обрано «{item.Name}».");
        }
        catch (Exception)
        {
            // Будь-яка непередбачена помилка — повідомлення, а не падіння сторінки (як у UC-01).
            ShowError("Не вдалося показати предмет на фото. Спробуйте ще раз.");
        }
        finally
        {
            _busy = false;
        }
    }

    // Користувач відпустив предмет: зберігаємо положення (FR-09) і повертаємо полотну остаточні значення.
    private PlacementValues OnPlacementChanged(int x, int y, decimal scale, int itemWidth, int itemHeight)
    {
        try
        {
            return Design.UpdatePlacement(x, y, scale, itemWidth, itemHeight);
        }
        catch (InvalidOperationException) when (Session.Placement is { } placed)
        {
            // Стан уже інший (напр., збережено): полотно повертаємо до того, що в сесії.
            return new PlacementValues(placed.X, placed.Y, placed.Scale);
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _saving = true;
        try
        {
            var png = await _canvas.ExportPngAsync();
            var result = await Design.SaveAsync(png);
            if (!result.IsSuccess)
            {
                ShowError(result.Message);
                return;
            }

            ShowInfo("Результат збережено в галерею.");
            await LockCanvasAsync();
        }
        catch (Exception)
        {
            // Будь-яка непередбачена помилка — повідомлення, а не падіння сторінки (як у UC-01).
            ShowError("Не вдалося зберегти результат. Спробуйте ще раз.");
        }
        finally
        {
            _busy = false;
            _saving = false;
        }
    }

    // «Завантажити»: PNG у роздільності оригіналу йде на комп'ютер користувача через браузер.
    // У БД і в сесію нічого не потрапляє, стан сесії не змінюється.
    private async Task DownloadAsync()
    {
        _busy = true;
        try
        {
            var png = await _canvas.ExportPngAsync();
            using var reference = new DotNetStreamReference(new MemoryStream(png));
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");
            await module.InvokeVoidAsync("downloadFile", DesignDownloadName.For(DateTime.UtcNow), reference);
        }
        catch (Exception)
        {
            ShowError("Не вдалося завантажити файл. Спробуйте ще раз.");
        }
        finally
        {
            _busy = false;
        }
    }

    // Після збереження предмет не рухається. Файл уже збережено, тому збій блокування не критичний:
    // якщо предмет таки зрушать, UpdatePlacement у стані SAVED відхилить зміну, а полотно повернеться до сесії.
    private async Task LockCanvasAsync()
    {
        try
        {
            await _canvas.SetLockedAsync(true);
        }
        catch (Exception)
        {
        }
    }

    private void ShowInfo(string text) => (_message, _isError) = (text, false);

    private void ShowError(string text) => (_message, _isError) = (text, true);
}
