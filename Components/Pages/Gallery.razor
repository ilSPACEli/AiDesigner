@page "/gallery"
@using AiDesigner.Clients.Gallery
@using AiDesigner.Models
@inject GalleryFacade Facade
@inject IJSRuntime JS

<PageTitle>Галерея — ШІ-дизайнер інтер'єру</PageTitle>

<main class="page">
    <header>
        <h1>Галерея</h1>
        <p class="subtitle">Збережені роботи</p>
    </header>

    @* AC-36: фільтр за стилем. Назви — з DisplayNames, як на сторінці «Дизайн». *@
    <div class="filter">
        <label for="style-filter">Стиль</label>
        <select id="style-filter" value="@StyleValue(_style)" @onchange="OnStyleChangedAsync" disabled="@_loading">
            <option value="">Усі стилі</option>
            @foreach (var style in Enum.GetValues<RoomStyle>())
            {
                <option value="@StyleValue(style)">@DisplayNames.Of(style)</option>
            }
        </select>
    </div>

    @if (_error is not null)
    {
        <div class="message error" role="alert">@_error</div>
    }

    @if (_loading)
    {
        <p class="status" role="status">Завантаження…</p>
    }
    else if (_loadFailed)
    {
        <button class="btn" @onclick="LoadAsync">Спробувати ще раз</button>
    }
    else if (_items.Count == 0)
    {
        @* AC-37: робіт обраного стилю немає — нейтральне повідомлення від фасаду, не помилка. *@
        @if (_notice is not null)
        {
            <p class="message info" role="status">@_notice</p>
        }
        else
        {
            <p class="status">Збережених робіт ще немає</p>
        }
    }
    else
    {
        <ul class="gallery-grid">
            @foreach (var item in _items)
            {
                <li class="card work" @key="item.Id">
                    <img src="@item.ThumbnailUrl" alt="@item.ItemName" loading="lazy" />
                    <div class="meta">
                        <strong>@item.ItemName</strong>
                        <span class="date">@item.DateText</span>
                        @if (item.Style is { } style)
                        {
                            @* AC-32: стиль роботи; «не визначено» — нейтрально, не як помилка. *@
                            <span class="style @(style.IsDetermined ? null : "undetermined")">@style.Text</span>
                        }
                    </div>

                    @if (_confirmingId == item.Id)
                    {
                        <p class="confirm-text">Видалити цю роботу?</p>
                        <div class="actions">
                            <button class="btn btn-danger" @onclick="() => DeleteAsync(item.Id)">Так, видалити</button>
                            <button class="btn btn-secondary" @onclick="CancelDelete">Скасувати</button>
                        </div>
                    }
                    else
                    {
                        <div class="actions">
                            <a class="btn btn-secondary" href="@item.ImageUrl" target="_blank" rel="noopener">Відкрити</a>
                            <a class="btn btn-secondary" href="@item.ImageUrl" download="@item.DownloadFileName">Завантажити</a>
                            <button class="btn btn-danger" @onclick="() => AskDelete(item.Id)"
                                    disabled="@(_busyId == item.Id)">
                                @(_busyId == item.Id ? "Видалення…" : "Видалити")
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</main>

@code {
    private List<GalleryItemView> _items = new();
    private bool _loading = true;       // перший показ — «Завантаження…»
    private bool _loadFailed;
    private string? _error;
    private string? _notice;            // AC-37: «немає робіт у стилі …» — від фасаду
    private RoomStyle? _style;          // null — «Усі стилі»
    private int? _confirmingId;         // картка, де зараз питаємо «Видалити цю роботу?»
    private int? _busyId;               // картка, яку зараз видаляють
    private string? _zoneId;            // пояс браузера (визначаємо один раз)
    private bool _zoneKnown;

    // Завантажуємо після першого показу, коли вже є інтерактивне з'єднання:
    // під час попереднього рендеру сторінка не робить запиту до власного API.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _error = null;
        _notice = null;
        _confirmingId = null;

        if (!_zoneKnown)
        {
            _zoneId = await GetTimeZoneIdAsync();
            _zoneKnown = true;
        }

        var loaded = await Facade.LoadAsync(_zoneId, _style);
        if (loaded.IsSuccess)
            _items = loaded.Items.ToList();

        _loadFailed = !loaded.IsSuccess;
        _error = loaded.Error;
        _notice = loaded.Notice;
        _loading = false;
        StateHasChanged();
    }

    // Сервер не знає пояса користувача — питаємо браузер. Не вийшло: null, фасад візьме пояс сервера.
    private async Task<string?> GetTimeZoneIdAsync()
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserInfo.js");
            return await module.InvokeAsync<string?>("getTimeZone");
        }
        catch (Exception)
        {
            return null;
        }
    }

    private async Task OnStyleChangedAsync(ChangeEventArgs e)
    {
        _style = ParseStyle(e.Value as string);
        await LoadAsync();
    }

    // Значення <option> — назва елемента RoomStyle; порожній рядок — «Усі стилі».
    private static string StyleValue(RoomStyle? style) => style?.ToString() ?? string.Empty;

    private static RoomStyle? ParseStyle(string? value) =>
        Enum.TryParse<RoomStyle>(value, out var style) && Enum.IsDefined(style) ? style : null;

    private void AskDelete(int id) => _confirmingId = id;

    private void CancelDelete() => _confirmingId = null;

    private async Task DeleteAsync(int id)
    {
        _confirmingId = null;
        _busyId = id;
        _error = null;

        var deleted = await Facade.DeleteAsync(id);
        _error = deleted.Error;
        if (deleted.RemoveCard)
            _items.RemoveAll(i => i.Id == id);   // і після успіху, і після 404; після збою робота лишається

        // Фільтр не скидаємо: видалили останню роботу стилю — те саме повідомлення, що й при завантаженні (AC-37).
        if (_items.Count == 0 && _style is { } style)
            _notice = GalleryFacade.NoWorksOfStyleMessage(style);

        _busyId = null;
    }
}
